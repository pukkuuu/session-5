class Book:
    def __init__(self, title, author, pages):  # TODO 1
        self.title = title
        self.author = author
        self.pages = pages
        self.is_available = True

    def checkout(self):  # TODO 2
        if self.is_available:
            self.is_available = False
            return True
        else:
            return False

    def return_book(self):  # TODO 3
        self.is_available = True
        return True

    def get_info(self):  # TODO 4
        availability = "Available" if self.is_available else "Not Available"
        return f"{self.title} by {self.author} ({self.pages} pages) - {availability}"

# Testing Your Implementation
def test_book_class():
    book1 = Book("The Hobbit", "J.R.R. Tolkien", 295)
    assert book1.get_info() == "The Hobbit by J.R.R. Tolkien (295 pages) - Available"
    assert book1.checkout() == True
    assert book1.get_info() == "The Hobbit by J.R.R. Tolkien (295 pages) - Not Available"
    assert book1.checkout() == False
    assert book1.return_book() == True
    assert book1.get_info() == "The Hobbit by J.R.R. Tolkien (295 pages) - Available"
    print("All tests passed.")

# Run the test function
test_book_class() 

